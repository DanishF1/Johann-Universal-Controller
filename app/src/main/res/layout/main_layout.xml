<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:background="@color/black"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="500px"
                android:layout_height="500px"
                android:id="@+id/logo"
                android:src="@mipmap/ic_launcher"
                android:rotation="90"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                >

            </ImageView>

            <androidx.appcompat.widget.SwitchCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintRight_toRightOf="@id/logo"
                app:layout_constraintLeft_toLeftOf="@id/logo"
                app:layout_constraintTop_toBottomOf="@id/logo"
                android:id="@+id/Ascend"
                app:showText="false"
                app:track="@drawable/custom_switch_off"
                android:thumb="@drawable/custom_switch_thub"
                android:rotation="90"
                android:gravity="center"
                android:layout_marginTop="20dp"
                ></androidx.appcompat.widget.SwitchCompat>
            <androidx.appcompat.widget.SwitchCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/logo"
                app:layout_constraintRight_toLeftOf="@id/Ascend"
                android:id="@+id/Hover"
                app:track="@drawable/custom_switch_off"
                android:thumb="@drawable/custom_switch_thub"
                app:showText="false"
                android:gravity="center"
                android:rotation="90"></androidx.appcompat.widget.SwitchCompat>
            <androidx.appcompat.widget.SwitchCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintRight_toLeftOf="@id/Hover"
                app:layout_constraintTop_toBottomOf="@id/logo"
                android:id="@+id/Descend"
                android:layout_marginTop="20dp"
                app:track="@drawable/custom_switch_off"
                android:thumb="@drawable/custom_switch_thub"
                app:showText="false"
                android:gravity="center"
                android:rotation="90">

            </androidx.appcompat.widget.SwitchCompat>
            <androidx.appcompat.widget.SwitchCompat
                android:layout_width="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_height="wrap_content"
                app:layout_constraintRight_toRightOf="@id/logo"
                app:layout_constraintLeft_toLeftOf="@id/logo"
                app:layout_constraintBottom_toTopOf="@id/logo"
                android:id="@+id/ConnectBLE"
                app:showText="false"
                app:track="@drawable/custom_switch_off"
                android:thumb="@drawable/custom_switch_thub"
                android:rotation="90"
                android:gravity="center"
                ></androidx.appcompat.widget.SwitchCompat>
            <androidx.appcompat.widget.SwitchCompat
                android:layout_width="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/logo"
                app:layout_constraintRight_toLeftOf="@id/ConnectBLE"
                android:id="@+id/RecVideo"
                app:showText="false"
                app:track="@drawable/custom_switch_off"
                android:thumb="@drawable/custom_switch_thub"
                android:rotation="90"
                android:gravity="center"
                ></androidx.appcompat.widget.SwitchCompat>


            <SeekBar
                android:layout_width="900px"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/Descend"
                android:layout_marginTop="155dp"
                android:progressDrawable="@drawable/custom_seekbar_track"

                android:thumb="@drawable/custom_seekbar_thumb"

                android:splitTrack="false"
                android:id="@+id/altitude">

            </SeekBar>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ascend"
                android:fontFamily="@font/poppins_regular"
                android:textSize="40px"
                android:rotation="90"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/Ascend"
                app:layout_constraintLeft_toLeftOf="@id/Ascend"
                app:layout_constraintRight_toRightOf="@id/Ascend"
                android:layout_marginTop="37dp"



                ></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hover"
                android:fontFamily="@font/poppins_regular"
                android:textSize="40px"
                android:rotation="90"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/Hover"
                app:layout_constraintLeft_toLeftOf="@id/Hover"
                app:layout_constraintRight_toRightOf="@id/Hover"
                android:layout_marginTop="30dp"



                ></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descend"
                android:fontFamily="@font/poppins_regular"
                android:textSize="40px"
                android:rotation="90"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/Descend"
                app:layout_constraintLeft_toLeftOf="@id/Descend"
                app:layout_constraintRight_toRightOf="@id/Descend"
                android:layout_marginTop="40dp"



                ></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect BLE"
                android:fontFamily="@font/poppins_regular"
                android:textSize="40px"
                android:rotation="90"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/ConnectBLE"
                app:layout_constraintLeft_toLeftOf="@id/ConnectBLE"
                app:layout_constraintRight_toRightOf="@id/ConnectBLE"
                android:layout_marginBottom="57dp"



                ></TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rec Video (TBA)"
                android:fontFamily="@font/poppins_regular"
                android:textSize="40px"
                android:rotation="90"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/RecVideo"
                app:layout_constraintLeft_toLeftOf="@id/RecVideo"
                app:layout_constraintRight_toRightOf="@id/RecVideo"
                android:layout_marginBottom="69dp"



                ></TextView>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.drawerlayout.widget.DrawerLayout>