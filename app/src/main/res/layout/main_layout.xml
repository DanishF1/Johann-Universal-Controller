<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:background="@color/black"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="500px"
            android:layout_height="500px"
            android:rotation="90"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </ImageView>

        <Switch
            android:id="@+id/Ascend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:gravity="center"
            android:rotation="90"
            android:thumbTint="#FFFFFF"
            android:thumbTintMode="multiply"
            android:trackTint="#B0B0B0"
            android:trackTintMode="src_in"
            android:scaleX="2.225"
            android:scaleY="2.225"
            android:textOff=""
            android:textOn=""
            app:layout_constraintLeft_toLeftOf="@id/logo"
            app:layout_constraintRight_toRightOf="@id/logo"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:showText="false"
            ></Switch>

        <Switch
            android:id="@+id/Hover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:gravity="center"
            android:rotation="90"
            android:thumbTint="#FFFFFF"
            android:thumbTintMode="multiply"
            android:trackTint="#B0B0B0"
            android:trackTintMode="src_in"
            android:scaleX="2.225"
            android:scaleY="2.225"
            android:textOff=""
            android:textOn=""
            app:layout_constraintRight_toLeftOf="@id/Ascend"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:showText="false"
            android:layout_marginRight="15dp"
            ></Switch>

        <Switch
            android:id="@+id/Descend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:gravity="center"
            android:rotation="90"
            android:thumbTint="#FFFFFF"
            android:thumbTintMode="multiply"
            android:trackTint="#B0B0B0"
            android:trackTintMode="src_in"
            android:scaleX="2.225"
            android:scaleY="2.225"
            android:textOff=""
            android:textOn=""
            app:layout_constraintRight_toLeftOf="@id/Hover"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:showText="false"
            android:layout_marginRight="15dp"
            >

        </Switch>

        <Switch
            android:id="@+id/ConnectBLE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="27dp"
            android:gravity="center"
            android:rotation="90"
            android:thumbTint="#FFFFFF"
            android:thumbTintMode="multiply"
            android:trackTint="#B0B0B0"
            android:trackTintMode="src_in"
            android:scaleX="2.225"
            android:scaleY="2.225"
            android:textOff=""
            android:textOn=""
            app:layout_constraintBottom_toTopOf="@id/logo"
            app:layout_constraintLeft_toLeftOf="@id/logo"
            app:layout_constraintRight_toRightOf="@id/logo"
            app:showText="false"
            ></Switch>

        <Switch
            android:id="@+id/RecVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="27dp"
            android:gravity="center"
            android:rotation="90"
            android:thumbTint="#FFFFFF"
            android:thumbTintMode="multiply"
            android:trackTint="#B0B0B0"
            android:trackTintMode="src_in"
            android:scaleX="2.225"
            android:scaleY="2.225"
            android:textOff=""
            android:textOn=""
            android:layout_marginRight="15dp"
            app:layout_constraintBottom_toTopOf="@id/logo"
            app:layout_constraintRight_toLeftOf="@id/ConnectBLE"
            app:showText="false"
            ></Switch>


        <SeekBar
            android:id="@+id/altitude"
            android:layout_width="900px"
            android:layout_height="wrap_content"
            android:layout_marginTop="155dp"
            android:progressDrawable="@drawable/custom_seekbar_track"
            android:scaleX="1"
            android:scaleY="1.2"
            android:splitTrack="false"

            android:thumb="@drawable/custom_seekbar_thumb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Descend"
            android:layout_marginBottom="51dp">

        </SeekBar>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="37dp"
            android:fontFamily="@font/poppins_regular"
            android:rotation="90"
            android:text="Ascend"
            android:textColor="@color/white"
            android:textSize="40px"
            app:layout_constraintLeft_toLeftOf="@id/Ascend"
            app:layout_constraintRight_toRightOf="@id/Ascend"
            app:layout_constraintTop_toBottomOf="@id/Ascend"


            ></TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/poppins_regular"
            android:rotation="90"
            android:text="Hover"
            android:textColor="@color/white"
            android:textSize="40px"
            app:layout_constraintLeft_toLeftOf="@id/Hover"
            app:layout_constraintRight_toRightOf="@id/Hover"
            app:layout_constraintTop_toBottomOf="@id/Hover"


            ></TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/poppins_regular"
            android:rotation="90"
            android:text="Descend"
            android:textColor="@color/white"
            android:textSize="40px"
            app:layout_constraintLeft_toLeftOf="@id/Descend"
            app:layout_constraintRight_toRightOf="@id/Descend"
            app:layout_constraintTop_toBottomOf="@id/Descend"


            ></TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="73dp"
            android:fontFamily="@font/poppins_regular"
            android:rotation="90"
            android:text="Connect BLE"
            android:textColor="@color/white"
            android:textSize="40px"
            app:layout_constraintBottom_toTopOf="@id/ConnectBLE"
            app:layout_constraintLeft_toLeftOf="@id/ConnectBLE"
            app:layout_constraintRight_toRightOf="@id/ConnectBLE"


            ></TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="85dp"
            android:fontFamily="@font/poppins_regular"
            android:rotation="90"
            android:text="Rec Video (TBA)"
            android:textColor="@color/white"
            android:textSize="40px"
            app:layout_constraintBottom_toTopOf="@id/RecVideo"
            app:layout_constraintLeft_toLeftOf="@id/RecVideo"
            app:layout_constraintRight_toRightOf="@id/RecVideo"


            ></TextView>

        <TextView
            android:id="@+id/newtoast"
            android:layout_width="145dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:rotation="90"
            android:textColor="@color/white"
            android:text="Bluetooth connected to Johann1.0"
            android:textSize="36px"
            android:textAlignment="center"
            android:alpha="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

            ></TextView>

        <TextView
            android:layout_width="125px"
            android:layout_height="wrap_content"
            app:layout_constraintRight_toRightOf="@id/altitude"
            android:rotation="90"
            app:layout_constraintBottom_toBottomOf="@id/altitude"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/white"
            android:text="0%"
            android:textSize="36px"
            android:layout_marginRight="-20dp"
            android:textAlignment="center"
            android:id="@+id/percentage">

        </TextView>




    </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.drawerlayout.widget.DrawerLayout>